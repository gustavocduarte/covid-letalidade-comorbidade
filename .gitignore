# Ambiente virtual — cada pessoa recria o seu (veja o README)
.venv/

# Dados brutos baixados do SIVEP-Gripe (~4,9 GB) — reproduzíveis rodando `python src/cli.py pipeline`
data/raw/

# Cache/arquivos temporários gerados automaticamente
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Configuração local de ferramentas (não é conteúdo do projeto)
.claude/
.vscode/
.idea/

# Segredos/config local — não existe hoje, mas fica pronto pra não vazar por acidente
.env
.streamlit/secrets.toml

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Cache intermediário grande (~140 MB), regenerável por `python src/cli.py pipeline`
data/processed/casos_covid_detalhado.csv
data/processed/*_detalhado.csv

# Metadados gerados por pip install -e
*.egg-info/
# Parquets por ano gerados pelo pipeline (reconstruíveis a partir de data/raw/)
data/processed/detalhado/
